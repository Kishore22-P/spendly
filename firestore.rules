rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify user identity
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Validate expense payload structure and bounds
    function isValidExpense() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'amount', 'category', 'date', 'paymentMethod'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.amount is number && data.amount > 0 && data.amount <= 100000000
        && data.category is string && data.category.size() >= 1
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.paymentMethod is string && data.paymentMethod.size() >= 1
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    // User profile & budgets document
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      // User expenses subcollection
      match /expenses/{expenseId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidExpense();
      }

      // Optional budgets subcollection (supports both map field on users/{uid} and subcollection)
      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
